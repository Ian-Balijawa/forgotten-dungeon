# CPack installers:  macOS -> .dmg   Windows -> .exe (NSIS) + .zip   Linux -> .deb + .tar.gz
set(CPACK_PACKAGE_NAME "ForgottenDungeon")
set(CPACK_PACKAGE_VENDOR "Forgotten Dungeon Team")
set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "A 3D dungeon adventure where the dungeon remembers")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "The Forgotten Dungeon")

if(APPLE)
  set(CPACK_GENERATOR "DragNDrop")
  set(CPACK_DMG_FORMAT "UDZO")
  set(CPACK_DMG_VOLUME_NAME "The Forgotten Dungeon")
  set(CPACK_PACKAGE_FILE_NAME "ForgottenDungeon-${PROJECT_VERSION}-macOS")
elseif(WIN32)
  set(CPACK_GENERATOR "NSIS;ZIP")
  set(CPACK_PACKAGE_EXECUTABLES "forgotten-dungeon" "The Forgotten Dungeon")  # Start-menu shortcut
  set(CPACK_NSIS_DISPLAY_NAME "The Forgotten Dungeon")
  set(CPACK_NSIS_MODIFY_PATH OFF)
  set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
  set(CPACK_PACKAGE_FILE_NAME "ForgottenDungeon-${PROJECT_VERSION}-Windows")
else()
  set(CPACK_GENERATOR "DEB;TGZ")
  set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Forgotten Dungeon Team <dev@example.com>")
  set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
  set(CPACK_DEBIAN_PACKAGE_SECTION "games")
  set(CPACK_PACKAGE_FILE_NAME "ForgottenDungeon-${PROJECT_VERSION}-Linux")
endif()

include(CPack)
